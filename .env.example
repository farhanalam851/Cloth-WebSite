# Copy this file to .env and fill in your real values.
# .env is already in .gitignore so it will never be committed.

# Get these from https://dashboard.razorpay.com/app/keys (use Test keys for development)
RAZORPAY_KEY_ID=rzp_test_yourkeyhere
RAZORPAY_KEY_SECRET=yoursecrethere

# Optional overrides — safe to leave out and use the defaults
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# SHIPPING_FLAT_RATE=99.00
# TAX_RATE_PERCENT=18.00
